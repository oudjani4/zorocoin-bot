# ==== Telegram Bot ====
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# رابط الـ Mini App بعد ما ترفعه (لازم HTTPS - استخدم ngrok وقت التجربة المحلية)
WEBAPP_URL=https://yourdomain.com/webapp/

# ==== Database ====
# مثال: postgresql://user:password@localhost:5432/zoro_airdrop
DATABASE_URL=postgresql://zoro_user:zoro_pass@localhost:5432/zoro_airdrop

# ==== قنوات تليجرام المطلوب الاشتراك فيها قبل التجميع ====
# اكتب الـ chat id أو الـ @username لكل قناة، مفصولين بفاصلة
REQUIRED_CHANNELS=@SmartEarnAr,@fortonxyz,@nodexvps,@zorocoinchat

# ==== إعدادات التعدين (Idle Mining) ====
# كام Zoro في الساعة يكسب المستخدم وهو شغال تعدين
MINING_RATE_PER_HOUR=10
# أقصى مدة تعدين متواصل بالساعات قبل ما يحتاج يفتح التطبيق ويكلم Claim تاني
MAX_SESSION_HOURS=3
# مكافأة المُحيل عن كل صديق ينضم عن طريق رابط الإحالة بتاعه
REFERRAL_BONUS=25

# ==== TonConnect ====
# رابط manifest.json بتاع تطبيقك (لازم يكون مستضاف على HTTPS - جزء من متطلبات TonConnect)
TONCONNECT_MANIFEST_URL=https://yourdomain.com/webapp/tonconnect-manifest.json

# ==== Backend ====
API_HOST=0.0.0.0
API_PORT=8000
# مفتاح سري لتوقيع أي عمليات إدارية (غيّره لأي قيمة عشوائية طويلة)
ADMIN_SECRET=change_me_to_a_long_random_string

# ==== التوزيع الفعلي للتوكن (scripts/distribute_tokens.py) ====
# ⚠️ أخطر سر في المشروع - محفظة التوزيع. متشاركهوش مع حد ولا ترفعه لأي مكان.
DISTRIBUTION_WALLET_MNEMONIC=word1 word2 word3 ... word24
# عنوان الـ Jetton Master بتاع توكن Zoro بعد الإطلاق
JETTON_MASTER_ADDRESS=
# عدد الخانات العشرية للتوكن (عادة 9 على TON)
JETTON_DECIMALS=9
# مفتاح API من https://toncenter.com (لو محتاج، يزود حد الطلبات)
TONCENTER_API_KEY=
# true وأنت بتجرب، خليه false بس وقت التوزيع الفعلي على mainnet
DISTRIBUTION_TESTNET=true
# فاصل بالثواني بين كل تحويل وتاني (تفادي مشاكل seqno/rate limit)
DISTRIBUTION_TX_DELAY_SECONDS=4
# عدد محاولات إعادة الإرسال لكل مستخدم قبل ما يتسجل "فشل نهائي"
DISTRIBUTION_MAX_RETRIES=3

# ==== تبويب Miner (نظام الـ 100 مستوى) ====
# أقصى مستوى متاح
MAX_LEVEL=100
# سعر الترقية من مستوى 1 لـ 2 (TON) - كل مستوى بعده بيزيد بمقدار LEVEL_PRICE_INCREMENT_TON
LEVEL_BASE_PRICE_TON=1.0
LEVEL_PRICE_INCREMENT_TON=0.5
# كام ZORO/ساعة بيتضاف لمعدل التعدين كل ما المستخدم يرتقي مستوى
LEVEL_MINING_RATE_INCREMENT=10
# محفظة الخزينة اللي بتستقبل مدفوعات الترقية (لازم تكون محفظتك انت، مش محفظة التوزيع)
TREASURY_WALLET_ADDRESS=
# قاعدة API بتاعة toncenter (غيّرها لو بتستخدم testnet: https://testnet.toncenter.com/api/v2)
TONCENTER_BASE_URL=https://toncenter.com/api/v2
# كام دقيقة يفضل طلب الترقية صالح قبل ما تنتهي صلاحيته
UPGRADE_REQUEST_TTL_MINUTES=30

# ==== الحد الأدنى للسحب ====
# نفس القيم دي لازم تتظبط زي بعضها هنا وفي scripts/distribute_tokens.py
# ⚠️ سعر الصرف ده قرارك انت وقت الإطلاق - غيّره حسب إجمالي المعروض والقيمة المستهدفة
ZORO_TO_TON_RATE=500
MIN_WITHDRAWAL_TON=0.5
